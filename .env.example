# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MAPTILER_API_KEY: Key for high-resolution satellite, topo, and street tiles.
MAPTILER_API_KEY="ymW6BFrW2yGn1M6oYm6h"

# ORS_API_KEY: Key for OpenRouteService routing and directions (optional, has OSRM fallback)
ORS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
